rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function esAnalista() {
      return request.auth != null
        && exists(/databases/$(database)/documents/analistas/$(request.auth.uid))
        && get(/databases/$(database)/documents/analistas/$(request.auth.uid)).data.activo == true;
    }
    function deporteAnalista() {
      return get(/databases/$(database)/documents/analistas/$(request.auth.uid)).data.deporte;
    }
    function esPremium() {
      return request.auth != null
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.suscripcion != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.suscripcion.activo == true
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.suscripcion.plan == 'premium';
    }
    // Puede usar el CHAT: admin, analista, o usuario con suscripcion activa Pro/Premium/Visitante.
    function puedeChatear() {
      return request.auth != null && (
        esAdmin() || esAnalista()
        || (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
            && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.suscripcion != null
            && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.suscripcion.activo == true
            && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.suscripcion.plan in ['pro', 'premium', 'visitante'])
      );
    }
    match /admins/{uid} {
      allow read: if esAdmin();
      allow write: if false;
    }
    match /analistas/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow create, delete: if esAdmin();
      allow update: if esAdmin()
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.deporte == resource.data.deporte
            && request.resource.data.activo  == resource.data.activo
            && request.resource.data.email   == resource.data.email);
    }
    match /usuarios/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow delete: if esAdmin();
    }
    match /fotos/{fotoId} {
      allow read:   if request.auth != null;
      allow create: if esAdmin() || (esAnalista() && request.resource.data.uid == request.auth.uid);
      allow delete: if esAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if false;
    }
    match /analisis/{id} {
      allow read: if esAdmin() || esAnalista() || esPremium();
      allow create: if esAdmin() || (esAnalista() && request.resource.data.deporte == deporteAnalista());
      allow update: if esAdmin() || (esAnalista() && resource.data.deporte == deporteAnalista());
      allow delete: if esAdmin() || (esAnalista() && resource.data.deporte == deporteAnalista());
    }
    // CHAT DE COMUNIDAD — leer: quien pueda chatear (Pro/Premium/Visitante/staff).
    // crear: solo el propio usuario, texto 1..400 caracteres. Editar: nadie. Borrar: solo admin (moderacion).
    match /chat/{msg} {
      allow read: if puedeChatear();
      allow create: if puedeChatear()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 400;
      allow update: if false;
      allow delete: if esAdmin();
    }
    match /seguimientos/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.seguidorUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.seguidorUid == request.auth.uid;
      allow update: if false;
    }
    match /config/contacto {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /config/analista {
      allow read: if true;
      allow write: if esAdmin();
    }
    match /config/{doc} {
      allow read: if esAdmin() || esAnalista();
      allow write: if esAdmin();
    }
    match /predicciones/{id} {
      allow read: if esAdmin();
      allow create: if request.auth != null && (esAdmin() || request.resource.data.analistaUid == request.auth.uid);
      allow update, delete: if esAdmin();
    }
    match /votos/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.valor == 1 || request.resource.data.valor == -1);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /apoyos/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /reportes/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid;
      allow read:   if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow update, delete: if esAdmin();
    }
  }
}
